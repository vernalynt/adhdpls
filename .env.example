# Copy to .env and edit. Never commit the real .env.

# Which address to listen on. 127.0.0.1 means "this computer only" (safe default).
# For phones, use a private address such as your Tailscale IP (run: tailscale ip -4).
BIND_IP=127.0.0.1
PORT=5055

# --- Optional: pull phone screenshots in from Immich (leave blank to turn it off) ---
# Immich running on the same machine as Docker:  http://host.docker.internal:2283
IMMICH_URL=
# Create the key in Immich (Account Settings, API Keys) with the permissions asset.read and asset.view
IMMICH_API_KEY=
# Files whose name starts with this are treated as screenshots
IMMICH_NAME_PREFIX=Screenshot

# --- Optional: put #reminder cards on Google Calendar (leave GCAL_CALENDAR_ID blank to turn it off) ---
# Needs a service account key saved as ./secrets/gcal.json (see the README).
GCAL_CALENDAR_ID=
GCAL_CREDENTIALS_FILE=/secrets/gcal.json
GCAL_TIMEZONE=UTC
